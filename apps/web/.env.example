# Gantry web — factory shell (apps/web)

# Production API origin (leave empty in dev — Vite proxies /v1 and /health to :8001)
# VITE_GANTRY_API_URL=https://api.your-gantry.example

# Local dev — skip API key modal (./dev.sh sets this; pair with GANTRY_DEV_AUTH_BYPASS on API)
# VITE_GANTRY_DEV_AUTH_BYPASS=true
